# Copy to .env and fill in. Only the two QWEN_ settings are required — without
# them you can still upload a file and browse everything the profiler derived,
# but the chat has no model to call.

# Base URL of your self-hosted Qwen wrapper. A full /chat/text URL also works;
# the client strips the endpoint and appends its own.
QWEN_API_URL=http://127.0.0.1:8000

# The value sent in the `api-key` header.
QWEN_API_KEY=

# Per-request timeout in seconds (default 300 — vision-class models are slow).
# QWEN_TIMEOUT=300

# Where uploaded warehouses live. One directory per dataset.
# DATA_DIR=./data

# Ceiling for a single upload, in megabytes.
# MAX_UPLOAD_MB=512
