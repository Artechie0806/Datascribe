# Copy to .env and fill in. Only LLM_API_URL is really required — without a
# model you can still upload a file and browse everything the profiler derived,
# but the chat has no model to call.
#
# Anything that speaks the OpenAI chat-completions API works: LM Studio,
# llama.cpp's server, Ollama, vLLM, or a hosted endpoint.

# Base URL of the server. With or without the /v1 — the client normalises it.
#   LM Studio   http://127.0.0.1:1234
#   Ollama      http://127.0.0.1:11434
#   llama.cpp   http://127.0.0.1:8080
LLM_API_URL=http://127.0.0.1:1234

# Bearer token. Local servers ignore it; leave blank.
LLM_API_KEY=

# Model id. Left blank, the client asks /v1/models and takes the first chat
# model it finds — which is what you want when only one is loaded, and not what
# you want when an embedding model is loaded beside it.
# LLM_MODEL=qwen/qwen3.5-9b

# --- sizing -----------------------------------------------------------------
# The context window the server was STARTED with, not the model's maximum. Every
# prompt is fitted to this, so setting it low silently degrades the schema the
# router sees; setting it above what the server will hold gets the prompt
# truncated by the server instead. Leave a couple of thousand tokens of headroom
# below the real figure for the reply.
LLM_CONTEXT=16000

# Generation caps. MIN is a floor applied to every call — a reasoning model
# needs room to think before it answers, and a 700-token cap is how you get an
# empty reply with finish_reason "length". MAX bounds a runaway.
# LLM_MIN_OUTPUT=1024
# LLM_MAX_OUTPUT=4096

# --- reasoning --------------------------------------------------------------
# none | low | medium | high. Qwen3-class models think before answering and
# bill it to the same budget as the answer: on this workload "low" spent 400-2500
# tokens and ~30s per call to reach the same JSON that "none" reaches in 3s.
# The schemas are ordered so the model reasons in its first field instead.
# Set "low" if you have latency to spare and want a second opinion on hard SQL.
# LLM_REASONING_EFFORT=none

# Extra tokens added to every cap when reasoning is NOT none.
# LLM_THINK_HEADROOM=2048

# 1 forces constrained decoding (response_format: json_schema), 0 disables it.
# Unset = detect it. Constrained decoding is the single biggest reliability win
# for a small model; only disable it if your server mis-implements it.
# LLM_JSON_SCHEMA=

# Concurrent describe calls during profiling. One local server means one model
# instance, so more workers mostly just queue.
# LLM_DESCRIBE_WORKERS=2

# Per-request timeout in seconds. Local models are slow; a big CPU-only model
# on a wide table can genuinely take minutes.
# LLM_TIMEOUT=600

# --- storage ----------------------------------------------------------------
# Where uploaded warehouses live. One directory per dataset.
# DATA_DIR=./data

# Ceiling for a single upload, in megabytes.
# MAX_UPLOAD_MB=512

# The old QWEN_API_URL / QWEN_API_KEY / QWEN_TIMEOUT names are still read.
